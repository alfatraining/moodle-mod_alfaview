{
    "name": "alfatraining/alfaview-moodle-plugin",
    "description": "Moodle Plugin to integrate the alfaview Video Conferencing platform.",
    "type": "project",
    "license": "MIT",
    "repositories": {
        "alfaview-php-sdk": {
            "type": "git",
            "url": "https://github.com/alfatraining/alfaview-php-sdk.git"
        }
    },
    "require": {
        "alfatraining/alfaview-php-sdk": "^3.0"
    },
    "replace": {
        "guzzlehttp/guzzle": "*",
        "guzzlehttp/promises": "*",
        "guzzlehttp/psr7": "*",
        "psr/http-client": "*",
        "psr/http-factory": "*",
        "psr/http-message": "*",
        "ralouphie/getallheaders": "*",
        "symfony/deprecation-contracts": "*",
        "symfony/polyfill-php80": "*"
    }
}
